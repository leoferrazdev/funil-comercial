<IfModule mod_dir.c>
  DirectoryIndex index.html
  DirectorySlash Off
</IfModule>
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Metadados antigos anunciavam serviços que não existem. Mesmo se sobrar
  # algum arquivo de um deploy anterior, esses endereços respondem HTTP 404 real.
  RewriteRule ^\.well-known/(api-catalog|oauth-authorization-server|http-message-signatures-directory|mcp/server-card\.json)/?$ - [R=404,L]
  RewriteRule ^(mcp|oauth/(authorize|token)|agent/(register|claim|revoke))/?$ - [R=404,L]

  # Em subrequisições de ErrorDocument 404 (ou acesso direto a 404.html), entrega
  # corpo Markdown quando o agente prefere text/markdown, mantendo status 404.
  RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
  RewriteCond %{HTTP:Accept} "(^|,)[\t ]*text/markdown[\t ]*(;[^,]*)?(,|$)" [NC]
  RewriteCond %{HTTP:Accept} "!(^|,)[\t ]*text/markdown[\t ]*(;[^,]*)?;[\t ]*q=0(\.0*)?[\t ]*(;|,|$)" [NC]
  RewriteCond %{HTTP:Accept} "!(^|,)[\t ]*text/html[\t ]*(;[^,]*)?(,|$)" [NC,OR]
  RewriteCond %{HTTP:Accept} "!(^|,)[\t ]*text/markdown[\t ]*(;[^,]*)?;[\t ]*q=0\.[0-9]+[\t ]*(;|,|$)" [NC,OR]
  RewriteCond %{HTTP:Accept} "(^|,)[\t ]*text/html[\t ]*(;[^,]*)?;[\t ]*q=0(\.[0-9]+)?[\t ]*(;|,|$)" [NC]
  RewriteRule ^404\.html$ /404.md [L]

  # Negociação Markdown para "/" e demais páginas públicas que possuem index.md.
  # Mantém preferência por HTML quando text/html tem prioridade maior ou q=0 recusa Markdown.
  RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
  RewriteCond %{HTTP:Accept} "(^|,)[\t ]*text/markdown[\t ]*(;[^,]*)?(,|$)" [NC]
  RewriteCond %{HTTP:Accept} "!(^|,)[\t ]*text/markdown[\t ]*(;[^,]*)?;[\t ]*q=0(\.0*)?[\t ]*(;|,|$)" [NC]
  RewriteCond %{HTTP:Accept} "!(^|,)[\t ]*text/html[\t ]*(;[^,]*)?(,|$)" [NC,OR]
  RewriteCond %{HTTP:Accept} "!(^|,)[\t ]*text/markdown[\t ]*(;[^,]*)?;[\t ]*q=0\.[0-9]+[\t ]*(;|,|$)" [NC,OR]
  RewriteCond %{HTTP:Accept} "(^|,)[\t ]*text/html[\t ]*(;[^,]*)?;[\t ]*q=0(\.[0-9]+)?[\t ]*(;|,|$)" [NC]
  RewriteCond %{DOCUMENT_ROOT}/index.md -f
  RewriteRule ^$ /index.md [L]

  RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
  RewriteCond %{HTTP:Accept} "(^|,)[\t ]*text/markdown[\t ]*(;[^,]*)?(,|$)" [NC]
  RewriteCond %{HTTP:Accept} "!(^|,)[\t ]*text/markdown[\t ]*(;[^,]*)?;[\t ]*q=0(\.0*)?[\t ]*(;|,|$)" [NC]
  RewriteCond %{HTTP:Accept} "!(^|,)[\t ]*text/html[\t ]*(;[^,]*)?(,|$)" [NC,OR]
  RewriteCond %{HTTP:Accept} "!(^|,)[\t ]*text/markdown[\t ]*(;[^,]*)?;[\t ]*q=0\.[0-9]+[\t ]*(;|,|$)" [NC,OR]
  RewriteCond %{HTTP:Accept} "(^|,)[\t ]*text/html[\t ]*(;[^,]*)?;[\t ]*q=0(\.[0-9]+)?[\t ]*(;|,|$)" [NC]
  RewriteCond %{DOCUMENT_ROOT}/$1/index.md -f
  RewriteRule ^(.+?)/?$ /$1/index.md [L]

  # Fallback defensivo caso exista apenas index.md sem index.html em algum caminho.
  RewriteCond %{REQUEST_FILENAME}/index.md -f
  RewriteCond %{REQUEST_FILENAME}/index.html !-f
  RewriteRule ^ /index.html [L]

  # Preservar endpoints de API e arquivos estáticos ou diretórios com index.html (sem 301 de trailing slash).
  RewriteCond %{REQUEST_URI} ^/api(/|$) [NC]
  RewriteRule ^ - [L]

  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  RewriteCond %{DOCUMENT_ROOT}/index.html -f
  RewriteRule ^$ /index.html [L]

  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]

  # Descoberta inexistente nunca deve receber HTML da SPA com status 200.
  RewriteRule ^\.well-known(/|$) - [R=404,L]

  # Rotas SPA dinâmicas / autenticadas explícitas (sem pré-render estático).
  RewriteRule ^(login|cadastro|redefinir-senha|dashboard|inbox|contatos|leads|funil|campanhas|criativos|roteiro|agregadores|pecas|perfil|configuracoes|whatsapp|oauth/(meta|instagram))/?$ /index.html [L]

  # Agregadores públicos (/l/:slug) e previews demonstrativos de prospecção conhecidos.
  RewriteRule ^l/[a-zA-Z0-9_-]+/?$ /index.html [L]
  RewriteRule ^(kns-odontologia|dra-talita-nacamura|brasiliense-odontologia|dra-marcia-yamashita|vilela-odontologia|cidmep-odontologia|dr-alexandre-serrano-lima|calligari-odontologia|flavia-martins-dentista|clins-odontologia)(/index\.html)?/?$ /index.html [L]

  # Rotas locais programáticas e guias por município válidos.
  RewriteRule ^(local|agencia-de-marketing|empresa-de-captacao|melhor-crm|google-meu-negocio)/(dentistas|advogados|psicologas|nutricionistas|arquitetos|contadores|medicos|esteticistas|corretores|fisioterapeutas|engenheiros|personal-trainers|energia-solar|oficinas-mecanicas)/[a-z]{2}/[a-z0-9-]+/?$ /index.html [L]
  RewriteRule ^blog/guia-de-vendas/(dentistas|advogados|psicologas|nutricionistas|arquitetos|contadores|medicos|esteticistas|corretores|fisioterapeutas|engenheiros|personal-trainers|energia-solar|oficinas-mecanicas)/[a-z]{2}/[a-z0-9-]+/?$ /index.html [L]

  # Qualquer outra URL desconhecida retorna HTTP 404 real (HTML ou Markdown).
  RewriteRule . - [R=404,L]
</IfModule>

<IfModule mod_mime.c>
  AddType text/markdown .md
  AddCharset UTF-8 .md .txt .html
</IfModule>

<Files "404.md">
  ForceType "text/markdown; charset=utf-8"
</Files>

<IfModule mod_headers.c>
  Header always set Link "</llms.txt>; rel=\"service-doc\"; type=\"text/plain\", </.well-known/ai-catalog.json>; rel=\"ai-catalog\"; type=\"application/json\", </.well-known/ard.json>; rel=\"ard\"; type=\"application/json\", </.well-known/poppy.json>; rel=\"https://personalagentprotocol.org/\"; type=\"application/json\""

  <FilesMatch "^(index|404)\.(html|md)$">
    Header always merge Vary "Accept"
  </FilesMatch>

  <FilesMatch "\.(md|txt|json)$">
    Header always set X-Content-Type-Options "nosniff"
  </FilesMatch>

  <FilesMatch "\.md$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # index.html SEMPRE revalidado: cada deploy é servido na hora, pois ele
  # referencia os bundles novos (com hash no nome).
  <FilesMatch "^index\.html$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>

  # Assets com hash com cache longo e imutável.
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <Files "agent-tools.js">
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>
</IfModule>
